import pandas as pd


def touristic(pricerange, foodquality):
    """Return True if the restaurant is touristic, False otherwise."""
    return pricerange == "cheap" and foodquality == "good"

def assigned_seats(crowdedness):
    """Return True if the restaurant has assigned seats (when busy)."""
    return crowdedness == "busy"

def child_friendly(lengthstay):
    """Return True if the restaurant is child friendly (not long stay)."""
    return lengthstay != "long"


def romantic(lengthstay, crowdedness):
    """Return True if the restaurant is romantic (long stay and not busy)."""
    return lengthstay == "long" or  crowdedness == "not busy"


def add_rules(df):
    """
    Add columns based on handwritten rules:
    - touristic
    - child_friendly
    - romantic
    - assigned_seats
    """
    df = df.assign(
        touristic=[touristic(p, f) for p, f in zip(df["pricerange"], df["foodquality"])],
        child_friendly=[child_friendly(l) for l in df["lengthstay"]],
        romantic=[romantic(l, c) for l, c in zip(df["lengthstay"], df["crowdedness"])],
        assigned_seats=[assigned_seats(c) for c in df["crowdedness"]],
    )
    return df


if __name__ == "__main__":
    # Add consequents and add to restaurant_data csv file
    df = pd.read_csv("data/restaurant_info_updated.csv")
    df_add = add_rules(df)
    df_add.to_csv("data/restaurant_data_consequents.csv")

    # Check if there are romantic restaurants
    print(df_add.loc[(df_add["romantic"])])