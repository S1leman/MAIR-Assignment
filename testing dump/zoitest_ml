def print_misclassifications(y_true, y_pred, utterances, model_name="Model", dataset_name="Dataset"):
    print(f"\n-- Misclassifications for {model_name} on {dataset_name} --")
    errors = 0
    for actual, pred, utt in zip(y_true, y_pred, utterances):
        if actual != pred:
            print(f"Utterance: {utt}")
            print(f"  Predicted: {pred}")
            print(f"  Actual:    {actual}\n")
            errors += 1
    if errors == 0:
        print("  No misclassifications found.")


from collections import Counter, defaultdict
def summarize_misclassifications(y_true, y_pred, model_name="Model", dataset_name="Dataset"):
    print(f"\n-- Misclassification Summary for {model_name} on {dataset_name} --")
    errors = defaultdict(Counter)

    for actual, pred in zip(y_true, y_pred):
        if actual != pred:
            errors[actual][pred] += 1

    if not errors:
        print("  No misclassifications found.")
        return

    for actual_act, preds in errors.items():
        details = ", ".join([f"{count}× as {pred_act}" for pred_act, count in preds.items()])
        print(f"For dialogue act '{actual_act}' it was misclassified {sum(preds.values())} times: {details}")





def main(): 
    path = "data/dialog_acts.dat"
    # original data
    dialogue_act_dup, utterance_dup = read_data(path, dedup=False)
    train_acts_dup, test_acts_dup, train_utterances_dup, test_utterances_dup=split_and_save_dataset(
        dialogue_act_dup, utterance_dup,
        train_path="data/train_dataset_dup.dat",
        test_path="data/test_dataset_dup.dat"
    )


    # deduplicated data
    dialogue_act_dedup, utterance_dedup = read_data(path, dedup=True)
    train_acts_dedup, test_acts_dedup, train_utterances_dedup, test_utterances_dedup=split_and_save_dataset(
        dialogue_act_dedup, utterance_dedup,
        train_path="data/train_dataset_dedup.dat",
        test_path="data/test_dataset_dedup.dat"
    )

    #train
    vec_dt_dedup, clf_dt_dedup = decision_tree(train_acts_dedup, train_utterances_dedup)
    vec_dt_dup,   clf_dt_dup  = decision_tree(train_acts_dup, train_utterances_dup)
    vec_gb_dedup,   clf_gb_dedup  = gradient_boosting(train_acts_dedup, train_utterances_dedup)
    vec_gb_dup,   clf_gb_dup  = gradient_boosting(train_acts_dup, train_utterances_dup)

    #classify
    y_pred_dt_dedup = classify_input(test_utterances_dedup, vec_dt_dedup, clf_dt_dedup)
    y_pred_dt_dup   = classify_input(test_utterances_dup,   vec_dt_dup,   clf_dt_dup)
    y_pred_gb_dedup = classify_input(test_utterances_dedup, vec_gb_dedup, clf_gb_dedup)
    y_pred_gb_dup   = classify_input(test_utterances_dup,   vec_gb_dup,   clf_gb_dup)

    # Evaluate
    evaluate(test_acts_dedup, y_pred_dt_dedup, name1=f"Decision Tree", name2="Deduplicated data")
    evaluate(test_acts_dup, y_pred_dt_dup, name1=f"Decision Tree", name2="Original data")
    evaluate(test_acts_dedup, y_pred_gb_dedup, name1=f"Gradient Boosting", name2="Deduplicated data")
    evaluate(test_acts_dup, y_pred_gb_dup, name1=f"Gradient Boosting", name2="Original data")

    #print_misclassifications(test_acts_dedup, y_pred_dt_dedup, test_utterances_dedup, model_name="Decision Tree", dataset_name="Deduplicated data")
    #print_misclassifications(test_acts_dup, y_pred_dt_dup, test_utterances_dup,model_name="Decision Tree", dataset_name="Original data")
    #summarize_misclassifications(test_acts_dedup, y_pred_dt_dedup, model_name="Decision Tree", dataset_name="Deduplicated data")
    #summarize_misclassifications(test_acts_dup, y_pred_dt_dup, model_name="Decision Tree", dataset_name="Original data")

    while True:
        user_input = input("Enter an utterance (type 'exit' to quit): ")
        if user_input.strip().lower() == "exit":
            break
        prediction = classify_input([user_input],  vec_dt_dup, clf_dt_dup)
        print(f"Predicted dialogue act: {prediction[0]}")



if __name__ == '__main__':
    main()